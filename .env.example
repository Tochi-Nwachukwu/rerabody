# Postgres. DATABASE_URL is the pooled connection used at runtime.
# DIRECT_URL is a direct (unpooled) connection used by Prisma Migrate and the seed.
DATABASE_URL=
DIRECT_URL=

# Better Auth. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ISO 4217 code. The store charges in USD
STORE_CURRENCY=USD

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Cloudflare R2 (S3-compatible API)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
NEXT_PUBLIC_MEDIA_URL=

RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM_ORDERS=
EMAIL_FROM_MARKETING=

# Sent by the cron scheduler as a header on /api/cron/* routes
CRON_SECRET=

# Used once by prisma/seed.ts to create the owner account
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=

# Optional. "log" writes emails to .emails/outbox.jsonl instead of sending (local work and tests).
EMAIL_TRANSPORT=resend

# Optional. Database used by integration tests. It is wiped between tests.
TEST_DATABASE_URL=

# Optional. Database used by the Playwright suite (migrated and seeded before each run).
E2E_DATABASE_URL=

# Optional. "local" keeps uploads on disk in .uploads/ for local work without R2. Default is r2.
STORAGE_DRIVER=r2

# Optional. "fake" replaces Stripe with a built-in test payment page (never use in production). Default is stripe.
PAYMENT_PROVIDER=stripe
# Stripe Tax: "on" only after the Stripe account has an active tax registration.
STRIPE_AUTOMATIC_TAX=off
